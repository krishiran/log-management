# คัดลอกไฟล์นี้เป็น .env — หรือรัน ./run.sh (Linux/macOS) / run.bat (Windows) ซึ่งจะสร้าง .env ให้
# และแทนที่ CHANGE_ME ทุกจุดด้วยค่าสุ่มอัตโนมัติ ห้าม commit ไฟล์ .env

# ============ ฐานข้อมูล ============
PGHOST=postgres
PGUSER=postgres
PGPASSWORD=CHANGE_ME
PGDATABASE=logdb
PGPORT=5432

# ============ ความปลอดภัย ============
# ใช้เซ็นชื่อ session (JWT) — ยาวอย่างน้อย 16 ตัวอักษร ถ้ายังเป็น CHANGE_ME แอปจะไม่ยอมเริ่มทำงาน
JWT_SECRET=CHANGE_ME
# API key สำหรับส่ง log เข้า /api/ingest  รูปแบบ  <tenant>=<key>,<tenant>=<key>
#   key ที่ผูกกับ tenant จะบังคับให้ log เป็นของ tenant นั้นเสมอ,  "*" = key ที่ส่งได้ทุก tenant
API_KEYS=demoA=CHANGE_ME,demoB=CHANGE_ME,*=CHANGE_ME
# รหัสผ่านผู้ใช้เริ่มต้น (ถูกสร้างครั้งแรกเมื่อฐานข้อมูลยังไม่มีผู้ใช้ และเก็บแบบ hash)
#   admin = เห็นทุก tenant และจัดการกฎ alert ได้,  viewerA/viewerB = เห็นเฉพาะ demoA/demoB
ADMIN_PASSWORD=CHANGE_ME_PW
VIEWERA_PASSWORD=CHANGE_ME_PW
VIEWERB_PASSWORD=CHANGE_ME_PW

# ============ ทั่วไป ============
APP_TIMEZONE=Asia/Bangkok
# เก็บ log กี่วัน (ขั้นต่ำตามโจทย์ = 7)
RETENTION_DAYS=7

# ============ Syslog ============
SYSLOG_PORT=514
# tenant ของ syslog ที่ไม่ได้ระบุ tenant=... ในข้อความ
SYSLOG_DEFAULT_TENANT=demoA
# (ไม่บังคับ) จับคู่ IP อุปกรณ์ → tenant เช่น 10.0.0.5=demoB,10.0.0.6=demoA
SYSLOG_TENANT_MAP=

# ============ แจ้งเตือน (ไม่บังคับ — ใส่ URL เพื่อให้ส่งแจ้งเตือนเมื่อกฎ alert เข้าเงื่อนไข) ============
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
# ระบบอื่นที่รับ JSON (ส่ง {"text","content","alert"})
WEBHOOK_URL=

# ============ โหมด SaaS (docker compose --profile saas) ============
# ผูกเว็บไว้ที่ localhost เพื่อให้เข้าผ่าน HTTPS ของ Caddy เท่านั้น (โหมด Appliance ใช้ 0.0.0.0)
APP_BIND=0.0.0.0
# โดเมนหรือ IP สาธารณะของ VM
DOMAIN=localhost
# "tls internal" = ใบรับรอง self-signed (ใช้กับ IP/ไม่มีโดเมน)   เว้นว่าง = ขอใบรับรองจริงจาก Let's Encrypt (ต้องมีโดเมน)
CADDY_TLS=tls internal
